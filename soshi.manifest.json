{
  "id": "finance",
  "name": "Finance",
  "icon": "wallet",
  "color": "#FF9F0A",
  "description": "AI-powered finance hub: invoicing, payments, revenue tracking, budgets, and financial reporting",
  "configSchema": "./src/config/schema.ts",
  "defaults": "./src/config/defaults.ts",
  "mcpServer": "./src/mcp/server.ts",
  "toolsPath": "./ui/src/lib/ai/tools/index.ts",
  "dataDir": "~/.finance/data/",

  "events": [
    {
      "name": "invoice_created",
      "description": "A new invoice was created",
      "schema": {
        "invoiceId": "string",
        "clientName": "string",
        "amount": "number",
        "currency": "string",
        "status": "string"
      }
    },
    {
      "name": "payment_received",
      "description": "A payment was received or recorded",
      "schema": {
        "paymentId": "string",
        "invoiceId": "string",
        "amount": "number",
        "method": "string"
      }
    },
    {
      "name": "invoice_overdue",
      "description": "An invoice passed its due date without payment",
      "schema": {
        "invoiceId": "string",
        "clientName": "string",
        "amount": "number",
        "dueDate": "string",
        "daysPastDue": "number"
      }
    },
    {
      "name": "refund_issued",
      "description": "A refund was processed for a payment",
      "schema": {
        "refundId": "string",
        "paymentId": "string",
        "amount": "number",
        "reason": "string"
      }
    },
    {
      "name": "budget_exceeded",
      "description": "Spending exceeded a budget threshold",
      "schema": {
        "category": "string",
        "budgetAmount": "number",
        "actualAmount": "number",
        "period": "string"
      }
    }
  ],

  "actions": [
    {
      "name": "create_invoice",
      "description": "Create a new invoice for a client",
      "tool": "create_invoice",
      "params": {
        "clientName": "string",
        "items": "object[]",
        "dueDate?": "string",
        "currency?": "string"
      }
    },
    {
      "name": "send_invoice",
      "description": "Send an invoice to the client",
      "tool": "send_invoice",
      "params": {
        "invoiceId": "string"
      }
    },
    {
      "name": "create_refund",
      "description": "Process a refund for a payment",
      "tool": "create_refund",
      "params": {
        "paymentId": "string",
        "amount?": "number",
        "reason?": "string"
      }
    },
    {
      "name": "add_transaction",
      "description": "Log a manual transaction",
      "tool": "add_transaction",
      "params": {
        "description": "string",
        "amount": "number",
        "type": "string",
        "category?": "string"
      }
    },
    {
      "name": "generate_report",
      "description": "Generate a financial report",
      "tool": "generate_report",
      "params": {
        "type": "string",
        "period?": "string"
      }
    }
  ],

  "routerKeywords": [
    "invoice", "invoices", "invoicing",
    "payment", "payments", "pay",
    "refund", "refunds",
    "revenue", "mrr", "arr",
    "budget", "budgets", "spending",
    "whop", "polar",
    "transaction", "transactions",
    "billing", "bill",
    "subscription", "subscriptions",
    "checkout", "product", "products",
    "report", "reports", "analytics",
    "profit", "expense", "expenses"
  ]
}
